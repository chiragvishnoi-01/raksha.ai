# RAKSHA AI Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Camera
CAMERA_INDEX=0
# Set to True to use synthetic/mock frames if webcam is unavailable or for testing
MOCK_CAMERA_FALLBACK=True

# Demo Location (Kanpur, Uttar Pradesh)
DEMO_LOCATION_NAME="NH-27 Highway, Kanpur, Uttar Pradesh, India"
DEMO_LATITUDE=26.4499
DEMO_LONGITUDE=80.3319

# Google Maps API (optional, will use realistic Kanpur medical fallback if empty)
GOOGLE_MAPS_API_KEY=""

# Email Alert Configuration (SMTP)
# Provide SMTP settings for live email dispatch; if left blank or dummy, RAKSHA logs alerts gracefully to file/console
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
ALERT_SENDER="raksha-alert@safety.gov.in"

# Alert Recipients (comma-separated or single)
HOSPITAL_ALERT_EMAIL="emergency-trauma@llr-hospital.org"
NHAI_ALERT_EMAIL="control-room@nhai.gov.in"
EMERGENCY_SERVICES_EMAIL="police-control@up112.gov.in"

# Database URL
# Uses PostgreSQL if available, otherwise falls back smoothly to SQLite: sqlite:///./raksha.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raksha_ai"

# AI Detection & Collision Parameters
YOLO_MODEL="yolov8n.pt"
COLLISION_IOU_THRESHOLD=0.15
COLLISION_DISTANCE_THRESHOLD=130
COLLISION_COOLDOWN_SECONDS=6.0
AI_CONFIDENCE_THRESHOLD=0.35
